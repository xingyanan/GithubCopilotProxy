{
  "name": "github-copilot-proxy",
  "productName": "Copilot Proxy",
  "version": "1.0.0",
  "description": "Desktop app that signs in to GitHub Copilot and serves OpenAI / Anthropic compatible APIs for Claude Code and Codex",
  "author": {
    "name": "xingyanan",
    "email": "xyn_data@163.com"
  },
  "homepage": "https://github.com/xingyanan/GithubCopilotProxy#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/xingyanan/GithubCopilotProxy.git"
  },
  "bugs": {
    "url": "https://github.com/xingyanan/GithubCopilotProxy/issues"
  },
  "main": "dist/main/main.js",
  "bin": {
    "copilot-proxy": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "cli": "npm run build && node dist/cli.js",
    "test": "npm run build && node scripts/mock-test.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:exe": "npm run build && electron-builder --win portable --x64",
    "dist:dir": "npm run build && electron-builder --win dir --x64",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "github-copilot",
    "proxy",
    "claude-code",
    "codex",
    "openai",
    "anthropic"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "io.github.xingyanan.copilotproxy",
    "productName": "Copilot Proxy",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CopilotProxy-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CopilotProxy-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "CopilotProxy-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "artifactName": "CopilotProxy-${version}-${arch}.${ext}",
      "category": "Development"
    },
    "copyright": "Copyright © 2026 xingyanan",
    "publish": null
  }
}
